# Process environment takes precedence over this file. Values are literal paths.
# Package roots: platform path separator (';' on Windows, ':' on POSIX).
# Empty uses ../em_design_modals relative to the source checkout.
EM_DESIGN_PACKAGE_ROOTS=
# Real execution only: use absolute installation paths; no solver ships here.
MATLAB_EXE=
COMSOL_MLI=
COMSOL_SERVER_PORT=2036
# Optional compatibility override. If empty, each package uses its own runs/ directory.
EM_DESIGN_MCP_RUNS_DIR=
